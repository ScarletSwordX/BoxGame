<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="LevelEditor.uss"/>
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement class="toolbar">
            <ui:Button name="newButton" text="新建"/>
            <ui:Button name="openButton" text="打开"/>
            <ui:Button name="saveButton" text="保存"/>
            <ui:Button name="saveAsButton" text="另存"/>
            <ui:Button name="undoButton" text="撤销"/>
            <ui:Button name="redoButton" text="重做"/>
            <ui:Button name="validateButton" text="校验"/>
            <ui:Button name="playtestButton" text="试玩"/>
            <ui:Button name="stopButton" text="停止"/>
            <ui:Button name="replayAButton" text="回放A"/>
            <ui:Button name="replayBButton" text="回放B"/>
            <ui:Button name="replayCButton" text="回放C"/>
            <ui:Button name="auditButton" text="互动审核"/>
        </ui:VisualElement>
        <ui:VisualElement class="meta">
            <ui:Label name="idLabel" text="id"/>
            <ui:IntegerField name="yField" label="Y" value="1"/>
            <ui:EnumField name="brushField" label="笔刷"/>
            <ui:TextField name="tokenField" label="词牌" value="WIN"/>
            <ui:TextField name="colorField" label="物种" value="ROBOT"/>
        </ui:VisualElement>
        <ui:VisualElement class="body">
            <ui:VisualElement name="gridHost" class="grid-host"/>
            <ui:VisualElement class="side">
                <ui:Label name="selectionLabel" text="未选择"/>
                <ui:Label name="diagLabel" text="" class="diag"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
