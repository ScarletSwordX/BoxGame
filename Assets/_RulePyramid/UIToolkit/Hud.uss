.hud-root {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(240, 240, 240);
}

.hud-top {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.45);
}

.hud-left {
    position: absolute;
    left: 16px;
    top: 64px;
    width: 280px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.4);
}

.hud-bottom {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.4);
}

.win-panel {
    position: absolute;
    left: 50%;
    top: 40%;
    translate: -50% -50%;
    padding: 24px;
    background-color: rgba(20, 20, 30, 0.9);
    border-width: 2px;
    border-color: rgb(255, 180, 220);
}

.hidden {
    display: none;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
}

.phase, .turns, .rules, .hint, .objective {
    white-space: normal;
    margin-top: 6px;
}

.reject {
    color: rgb(255, 160, 120);
    margin-top: 6px;
}

.row {
    flex-direction: row;
    margin-top: 8px;
}

.section {
    -unity-font-style: bold;
}
