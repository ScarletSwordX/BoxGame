.hud-root {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(0, 0, 0);
}

.hud-top {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.8);
}

.hud-left {
    position: absolute;
    left: 16px;
    top: 64px;
    width: 280px;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.8);
}

.hud-bottom {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    padding: 12px;
    background-color: rgba(255, 255, 255, 0.8);
}

.win-panel {
    position: absolute;
    left: 50%;
    top: 40%;
    translate: -50% -50%;
    padding: 24px;
    background-color: rgba(250, 241, 225, 0.95);
    border-width: 2px;
    border-color: rgb(255, 180, 220);
}

.hidden {
    display: none;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
}

.phase, .turns, .rules, .hint, .objective {
    white-space: normal;
    margin-top: 6px;
}

.reject {
    color: rgb(180, 0, 0);
    margin-top: 6px;
}

.hint.no-control {
    color: rgb(180, 0, 0);
}

.row {
    flex-direction: row;
    margin-top: 8px;
}

.section {
    -unity-font-style: bold;
}

.stage-transition {
    position: absolute;
    top: 18%;
    align-self: center;
    padding: 12px 24px;
    background-color: rgba(250, 241, 225, 0.95);
    color: rgb(0, 0, 0);
    font-size: 22px;
    -unity-font-style: bold;
}

.game-hud {
    flex-grow: 1;
}

.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    color: rgb(66, 57, 73);
}

.main-menu {
    background-color: rgb(237, 223, 201);
}

.menu-card {
    width: 480px;
    max-width: 90%;
    padding: 32px 54px;
    align-items: stretch;
    background-color: rgb(250, 241, 225);
    border-radius: 16px;
    border-width: 2px;
    border-bottom-width: 8px;
    border-color: rgb(200, 184, 166);
}

.word-tiles {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 22px;
}

.word-tile {
    width: 90px;
    height: 64px;
    margin-left: 5px;
    margin-right: 5px;
    border-radius: 8px;
    border-bottom-width: 5px;
    border-bottom-color: rgba(66, 57, 73, 0.23);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 21px;
    color: rgb(53, 51, 62);
}

.noun-tile { background-color: rgb(172, 203, 210); }
.operator-tile { background-color: rgb(210, 196, 224); }
.property-tile { background-color: rgb(239, 197, 141); }

.menu-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 38px;
    letter-spacing: 0;
    margin-bottom: 8px;
}

.menu-subtitle {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 18px;
    color: rgb(116, 100, 99);
}

.menu-divider {
    height: 2px;
    background-color: rgb(224, 209, 188);
    margin-top: 24px;
    margin-bottom: 20px;
}

.menu-button {
    height: 54px;
    margin: 5px 0;
    border-radius: 8px;
    border-width: 2px;
    border-bottom-width: 4px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(66, 57, 73);
}

.primary-button {
    background-color: rgb(210, 196, 224);
    border-color: rgb(168, 148, 187);
}

.secondary-button {
    background-color: rgb(245, 231, 210);
    border-color: rgb(210, 189, 165);
}

.menu-button:hover {
    background-color: rgb(232, 216, 244);
    border-color: rgb(139, 116, 158);
}

.menu-button:focus {
    border-color: rgb(114, 86, 141);
}

.menu-button:active {
    background-color: rgb(194, 172, 212);
    border-bottom-width: 2px;
}

.pause-menu { background-color: rgba(60, 49, 67, 0.56); }
.pause-card { width: 440px; }
.pause-title {
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}
.pause-footer {
    margin-top: 18px;
    font-size: 14px;
    color: rgb(116, 100, 99);
    -unity-text-align: middle-center;
}
/* 两种结算共用布局，通过标题和主按钮区分完成范围。 */
.completion-screen {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(41, 50, 70, 0.26);
}
.completion-card {
    width: 440px; max-width: 85%; padding: 28px 32px;
    background-color: rgb(250, 241, 225); color: rgb(41, 50, 70);
    border-radius: 14px; border-width: 2px; border-bottom-width: 7px;
}
.stage-card { border-color: rgb(158, 141, 183); }
.level-card { border-color: rgb(190, 146, 63); }
.completion-title { font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; }
.completion-context { font-size: 16px; white-space: normal; -unity-text-align: middle-center; margin-top: 10px; }
.stage-primary { background-color: rgb(191, 179, 214); border-color: rgb(158, 141, 183); color: rgb(41, 50, 70); margin-top: 20px; }
.level-primary { background-color: rgb(236, 198, 107); border-color: rgb(190, 146, 63); color: rgb(41, 50, 70); margin-top: 20px; }
