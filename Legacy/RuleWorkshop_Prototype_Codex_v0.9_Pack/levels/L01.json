  "tutorial": {
    "concept": "先认识走、登攀与“进入目标”，不要一上来学习推物或拆句。",
    "observation": "旗标是一个可进入的一格轮廓；平台高一格，普通方向就能登上。",
    "necessity": "本关有意允许不改变任何物品的通关，作为后续互动审核的正向对照，不占多解配额。",
    "narratives": [
      {
        "solutionId": "A",
        "text": "从出生点沿 +X 走过低处，登上固定一格台阶，最后真正进入旗标格。四视角切换可随时插入，但不属于逻辑回合。"
      }
    ],
    "hints": [
      "看看旗标的空心轮廓占的是哪一格。",
      "普通方向可以登上一格；站在目标旁边还不算进入。",
      "沿平台继续向 +X 前进，进入旗标，而不是停在它前一格。"
    ],
    "risks": [
      "不要把相邻即胜或“碰到外壳”加回来。",
      "用地面箭头解释视角切换后的方向，不靠屏幕投影判断高差。"
    ]
  },
