  "tutorial": {
    "concept": "HOVER 只决定高度，STOP 才让悬云能承托。",
    "observation": "两岸同高，中间三朵云已经悬停，但云影没有实体顶面。",
    "necessity": "未实体化时玩家穿过云影并落到下层，不能连续横跨三格缺口，也不能从下层一次登上两格高的岸。",
    "narratives": [
      {
        "solutionId": "A",
        "text": "将 STOP 推入 CLOUD IS ___，让三朵云同时产生承托面；返回岸边，沿三朵云的顶面走到另一岸，进入旗标。"
      }
    ],
    "hints": [
      "云没有掉落，不等于它能托住你。",
      "找一条能改变云实体性的句子。",
      "拼成 CLOUD IS STOP，再走到云的顶面。"
    ],
    "risks": [
      "实体反馈要在第一次踩踏前可见。",
      "保留实际下层底板；掉下去不触发隐形传送或自动胜利。"
    ]
  },
